# Copy to .env. Every key is optional; collectors without credentials are skipped.
SPT_DATABASE_URL=postgresql+psycopg://pizza:pizza@db:5432/pizza
SPT_CONTACT_EMAIL=you@example.com        # required by SEC EDGAR; sent in our User-Agent
SPT_WSDOT_ACCESS_CODE=                   # free: https://wsdot.wa.gov/traffic/api/
SPT_BESTTIME_API_KEY=                    # licensed foot traffic: https://besttime.app
SPT_ALPHA_VANTAGE_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
