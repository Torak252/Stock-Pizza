# Copy to backend/.env. Everything here is free; every key is optional.
# Keep comments on their own lines: a blank value followed by "# ..." would be read as the value.

SPT_DATABASE_URL=sqlite:///./pizza_tracker.db

# Your email. SEC EDGAR requires it in the User-Agent; filings are skipped until it is set.
SPT_CONTACT_EMAIL=

# Free keys (optional): WSDOT https://wsdot.wa.gov/traffic/api/ · 511PA https://www.511pa.com/developers
# TomTom (traffic vs free-flow) https://developer.tomtom.com
SPT_WSDOT_ACCESS_CODE=
SPT_PA511_API_KEY=
SPT_TOMTOM_API_KEY=
